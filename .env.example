# Format: KEY=VALUE only (no shell command substitution)

# Workflow-specific keys; none are globally required.
# HyperSync historical queries / transaction analysis — https://envio.dev
HYPERSYNC_API_TOKEN=

# Etherscan API key — works for all chains via V2 API
# Get one at https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# CoinGecko Pro API key (optional); leave empty for unauthenticated public access.
# This script uses the Pro endpoint when set; Demo keys are not supported.
COINGECKO_API_KEY=

# Optional external routing only; manual --mode needs no key.
# --jev sends the explicitly supplied sanitized request JSON to TypeSafe.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
