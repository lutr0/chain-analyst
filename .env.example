# Format: KEY=VALUE only (no shell command substitution)

# HyperSync API token — get one at https://envio.dev
HYPERSYNC_API_TOKEN=

# Etherscan API key — works for all chains via V2 API
# Get one at https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# CoinGecko API key (optional) — free tier works without a key but is rate-limited (~10-30 req/min)
# For higher limits, get a Demo key at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
